{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run web app (Flask)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Scan (common ports, real)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["scan", "127.0.0.1", "--common", "--show-closed"],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Scan (simulated demo)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["scan", "example.com", "--common", "--simulate", "--seed", "42"],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Run tests",
            "type": "debugpy",
            "request": "launch",
            "module": "unittest",
            "args": ["discover", "-s", "tests", "-v"],
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
